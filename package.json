{
  "name": "feet-bot",
  "version": "1.0.0",
  "description": "FEET (Fluxer Expandable Everyday Toolkit) — a pluggable bot for Fluxer",
  "keywords": [
    "bot",
    "fluxer"
  ],
  "homepage": "https://github.com/TheInternetUse7/feet#readme",
  "bugs": {
    "url": "https://github.com/TheInternetUse7/feet/issues"
  },
  "license": "MIT",
  "author": "TheInternetUse7",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheInternetUse7/feet.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check"
  },
  "dependencies": {
    "@extractus/feed-extractor": "^7.2.1",
    "@fluxerjs/core": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.5"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
